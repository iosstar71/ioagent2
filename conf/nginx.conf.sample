# =============================================================================
# IOSTAR-PM — 웹 서버(nginx)를 앞에 둘 때의 설정 예시  (라이선스: nginx BSD-2-Clause)
#   브라우저 ──HTTPS(443)──▶ nginx ──HTTP(127.0.0.1:8080)──▶ IOSTAR-PM 서버(run_server.bat)
#   - nginx : HTTPS · 정적 파일(webapp/static) · 올리기 크기 제한
#   - 서버  : conf/app.ini 에서 host=127.0.0.1 로 바꾸고, certs 폴더의 인증서는 쓰지 않음(HTTP 로 기동)
#   - /opt/iostar-pm 은 프로그램 폴더, pm.example.local 은 접속 주소로 바꿔 쓰세요.
# =============================================================================
server {
    listen 443 ssl;
    server_name pm.example.local;

    ssl_certificate     /opt/iostar-pm/certs/server.crt;
    ssl_certificate_key /opt/iostar-pm/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 21m;          # 첨부파일 1개 최대 20MB (conf/app.ini [files] max_file_mb 와 맞춤)
    add_header Strict-Transport-Security "max-age=15552000" always;

    # 정적 파일(스타일 · 스크립트 · 글꼴 · 그림)은 nginx 가 직접 보냄
    location /static/ {
        root /opt/iostar-pm/webapp;
        gzip on;
        gzip_types text/css application/javascript;
        add_header Cache-Control "no-cache";      # 버전을 올린 뒤 이전 화면이 남지 않도록 매번 확인
        add_header X-Content-Type-Options nosniff;
    }
    # 화면 설정은 서버가 conf/app.ini 로 만들어 보냄
    location = /static/js/config/app-config.js { proxy_pass http://127.0.0.1:8080; }

    # 그 밖(화면 · API · 첨부파일)은 IOSTAR-PM 서버로
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;   # 올리는 파일을 서버로 바로 흘려 보냄
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name pm.example.local;
    return 301 https://$host$request_uri;
}
